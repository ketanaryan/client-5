generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  CLIENT
  ASSOCIATE
}

enum WorkStatus {
  PENDING
  IN_PROGRESS
  AWAITING_CLIENT
  FOR_REVIEW
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  passwordHash     String
  role             Role              @default(CLIENT)
  userCode         String?           @unique
  phone            String?
  image            String?
  address          String?
  age              Int?
  gender           String?
  isActive         Boolean           @default(true)
  isFirstLogin     Boolean           @default(true)
  kycStatus        String            @default("PENDING")
  createdAt        DateTime          @default(now())
  
  clientProfile    ClientProfile?
  associateProfile AssociateProfile?
  activityLogs     ActivityLog[]
  sentMessages     Message[]         @relation("SentMessages")
  receivedMessages Message[]         @relation("ReceivedMessages")
  internalNotes    InternalNote[]
  documents        Document[]
  notifications    Notification[]
  assignedRequests WorkRequest[]     @relation("AssignedStaff")
  managedGroups    ClientGroup[]     @relation("GroupManager")

  @@index([email])
  @@index([role])
}

model ClientProfile {
  id                 String        @id @default(uuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedPan       String?
  encryptedGst       String?
  panDocumentUrl     String?
  gstDocumentUrl     String?
  kycRejectionReason String?
  companyName        String?
  address            String?
  groupId            String?
  clientGroup        ClientGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  workRequests       WorkRequest[]

  @@index([groupId])
}

model ClientGroup {
  id               String          @id @default(uuid())
  name             String
  primaryContactId String
  primaryContact   User            @relation("GroupManager", fields: [primaryContactId], references: [id])
  clientProfiles   ClientProfile[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([primaryContactId])
}

model AssociateProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkRequest {
  id              String         @id @default(uuid())
  clientId        String
  client          ClientProfile  @relation(fields: [clientId], references: [id])
  title           String
  status          WorkStatus     @default(PENDING)
  priority        Priority       @default(MEDIUM)
  assignedStaffId String?
  assignedStaff   User?          @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  feeAmount       Float?
  createdAt       DateTime       @default(now())
  dueDate         DateTime?
  
  invoices        Invoice[]
  tasks           Task[]
  notes           InternalNote[]
  documents       Document[]

  @@index([clientId])
  @@index([assignedStaffId])
  @@index([status])
}

model Task {
  id            String      @id @default(uuid())
  workRequestId String
  workRequest   WorkRequest @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  description   String
  isCompleted   Boolean     @default(false)

  @@index([workRequestId])
}

model InternalNote {
  id            String      @id @default(uuid())
  workRequestId String
  workRequest   WorkRequest @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  content       String
  createdAt     DateTime    @default(now())

  @@index([workRequestId])
  @@index([authorId])
}

model ActivityLog {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  actionDescription String
  timestamp         DateTime @default(now())

  @@index([userId])
}

model Invoice {
  id            String        @id @default(uuid())
  workRequestId String
  workRequest   WorkRequest   @relation(fields: [workRequestId], references: [id])
  amount        Float
  status        InvoiceStatus @default(UNPAID)
  issuedDate    DateTime      @default(now())
  
  payments      Payment[]

  @@index([workRequestId])
  @@index([status])
}

model Payment {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  amount     Float
  utrNumber  String
  receiptUrl String?
  status     WorkStatus @default(PENDING)
  createdAt  DateTime @default(now())

  @@index([invoiceId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model Enquiry {
  id               String        @id @default(uuid())
  name             String
  email            String
  phone            String?
  serviceRequested String?
  message          String
  status           EnquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())

  @@index([status])
}

model Document {
  id            String       @id @default(uuid())
  title         String
  fileUrl       String
  uploadedById  String
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  workRequestId String?
  workRequest   WorkRequest? @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([uploadedById])
  @@index([workRequestId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Reminder {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime
  type        String   @default("CUSTOM")
  targetCount Int      @default(0)
  targetGroup String   @default("ALL")
  createdAt   DateTime @default(now())
  isCompleted Boolean  @default(false)

  @@index([dueDate])
  @@index([isCompleted])
}
